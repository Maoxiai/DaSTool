<!--pages/home/me/index.wxml-->
<view class="container {{darkMode ? 'dark' : ''}}">
  <!-- 用户卡片 -->
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="head-img" src="{{headeSrcPath}}" />
    </button>
    <input wx:if="{{!userName}}" class="nickname-input" type="nickname" placeholder="点击登录" bind:input="onNicknameInput" bind:blur="onNicknameBlur" />
    <view wx:else class="nickname-text">{{userName}}</view>
    <view class="quote">{{dailyQuote}}</view>
  </view>

  <!-- 功能列表 -->
  <view class="group">
    <button class="cell" open-type="share" hover-class="cell-hover">
      <text class="cell-icon">📤</text>
      <text class="cell-title">分享给好友</text>
      <text class="cell-arrow">›</text>
    </button>
    <view class="cell-divider"></view>
    <button class="cell" open-type="feedback" hover-class="cell-hover">
      <text class="cell-icon">💬</text>
      <text class="cell-title">反馈与建议</text>
      <text class="cell-arrow">›</text>
    </button>
    <view class="cell-divider"></view>
    <view class="cell" hover-class="cell-hover" bind:tap="goAbout">
      <text class="cell-icon">ℹ️</text>
      <text class="cell-title">关于</text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="group">
    <view class="cell">
      <text class="cell-icon">🌙</text>
      <text class="cell-title">深色模式</text>
      <switch class="cell-switch" checked="{{darkMode}}" color="#ff5f15" bindchange="onDarkModeChange" />
    </view>
  </view>
</view>
