<view class="about {{darkMode ? 'dark' : ''}}">
  <view class="about-logo">DaS</view>
  <view class="about-name">DaS云芯</view>
  <view class="about-version" bind:tap="onVersionTap">版本 V{{version}}</view>
  <view class="about-desc">聚合型工具箱小程序，日常小工具集合</view>

  <view class="about-stats">
    <view class="stat-item">
      <view class="stat-num">{{toolCount}}</view>
      <view class="stat-label">工具总数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{categoryCount}}</view>
      <view class="stat-label">工具分类</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">V{{version}}</view>
      <view class="stat-label">当前版本</view>
    </view>
  </view>

  <view class="about-features">
    <text class="feature-icon">🧮</text>
    <text class="feature-icon">📷</text>
    <text class="feature-icon">🎨</text>
    <text class="feature-icon">🔧</text>
  </view>

  <view class="about-footer">
    <view class="footer-desc">工具计算结果仅供参考，请以实际情况为准。</view>
    <view class="footer-dev">DaS云芯 · 用心打造每一个小工具</view>
  </view>
</view>
