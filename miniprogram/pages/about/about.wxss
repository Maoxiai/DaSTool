/* pages/about/about.wxss */
.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.about-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: #ff5f15;
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-name {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
  margin-top: 36rpx;
}

.about-version {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.about-desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 28rpx;
  text-align: center;
  line-height: 1.6;
}

/* 深色模式 */
.dark {
  background-color: #1f1f1f;
}

.dark .about-name {
  color: #e5e5e5;
}

.dark .about-desc {
  color: #999;
}
