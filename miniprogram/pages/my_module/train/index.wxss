.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-family: Menlo, Consolas, monospace;
}

.error-card {
  background: #fdecea;
  color: #e53935;
  border-radius: 14rpx;
  margin: 0 20rpx 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 36rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.result-title {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-row:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 26rpx;
  color: #666;
}

.result-value {
  font-size: 30rpx;
  color: #4A90E2;
  font-weight: 600;
}

.result-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.6;
}

.type-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.type-row:last-child {
  border-bottom: none;
}

.type-code {
  width: 70rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #ff5f15;
  flex-shrink: 0;
}

.type-body {
  flex: 1;
  min-width: 0;
}

.type-name {
  font-size: 28rpx;
  color: #333;
}

.type-speed {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}