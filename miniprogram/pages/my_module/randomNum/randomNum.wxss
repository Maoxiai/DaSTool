.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f6f6f6;
}

/* 玩法 tab */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.25s ease;
}

.tab.active {
  background: #ff5f15;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 95, 21, 0.35);
}

/* 面板 */
.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.panel-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 通用输入 */
.range-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.input {
  width: 200rpx;
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  text-align: center;
  font-size: 34rpx;
  font-family: Menlo, Consolas, monospace;
}

.range-sep {
  margin: 0 24rpx;
  font-size: 36rpx;
  color: #999;
}

.label {
  font-size: 26rpx;
  color: #666;
}

/* 随机数结果 */
.result-box {
  height: 280rpx;
  line-height: 280rpx;
  text-align: center;
  font-size: 140rpx;
  font-weight: bold;
  color: #ff5f15;
  background: #fff7f2;
  border-radius: 20rpx;
  font-family: Menlo, Consolas, monospace;
}

.result-box.rolling {
  animation: shake 0.3s ease infinite;
}

@keyframes shake {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

/* 骰子 */
.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  text-align: center;
  line-height: 64rpx;
  font-size: 34rpx;
  color: #333;
}

.step-val {
  min-width: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.dice-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.dice {
  width: 100rpx;
  height: 100rpx;
  background: #fff7f2;
  border: 2rpx solid #ffe0cc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.dice-list.rolling .dice {
  animation: dice-roll 0.3s ease infinite;
}

@keyframes dice-roll {
  0%, 100% { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(12deg) scale(1.08); }
}

.dice-symbol {
  font-size: 44rpx;
  line-height: 1;
}

.dice-num {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.dice-total {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  margin-top: 24rpx;
  font-weight: 600;
}

/* 硬币 */
.coin {
  font-size: 180rpx;
  line-height: 1;
  margin: 20rpx 0;
}

.coin.flip {
  animation: coin-flip 0.35s ease infinite;
}

@keyframes coin-flip {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(180deg); }
}

.coin-side {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

/* 抽数字 */
.pick-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.pick-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.inline-input {
  display: flex;
  align-items: center;
}

.pick-results {
  display: flex;
  flex-wrap: wrap;
}

.pick-chip {
  padding: 14rpx 28rpx;
  background: #fff7f2;
  border: 2rpx solid #ffd9bf;
  border-radius: 14rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #ff5f15;
}

/* 大按钮 */
.go-btn {
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff7a3d, #ff5f15);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 55rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 95, 21, 0.35);
  transition: transform 0.15s ease;
}

.go-hover {
  transform: scale(0.96);
}

.go-btn.disabled {
  opacity: 0.6;
}

/* 历史记录 */
.history {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.history-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.history-clear {
  font-size: 24rpx;
  color: #999;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.history-text {
  font-size: 26rpx;
  color: #666;
}