.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}

/* Hero 头部卡 */
.hero {
  background: linear-gradient(135deg, #1b2a4a, #2c4a6e);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(27, 42, 74, 0.3);
  animation: hero-in 0.5s ease both;
}

@keyframes hero-in {
  0% { opacity: 0; transform: translateY(-20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-province {
  display: flex;
  align-items: baseline;
}

.hero-province-name {
  font-size: 56rpx;
  font-weight: bold;
}

.hero-province-label {
  font-size: 26rpx;
  opacity: 0.7;
  margin-left: 20rpx;
}

.hero-switch {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  transition: background 0.2s ease;
}

.hero-switch:active {
  background: rgba(255, 255, 255, 0.28);
}

.hero-switch-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
}

.hero-time {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  opacity: 0.7;
}

.hero-time-dot {
  color: #4ade80;
  margin-right: 10rpx;
  font-size: 18rpx;
}

/* 油价卡片列表 */
.oil-list {
  display: flex;
  flex-direction: column;
}

.oil-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  opacity: 0;
  animation: card-in 0.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  transition: transform 0.15s ease;
}

.oil-card:active {
  transform: scale(0.98);
}

@keyframes card-in {
  0% { opacity: 0; transform: translateY(30rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.oil-left {
  display: flex;
  align-items: center;
}

.oil-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f4f8;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.oil-info {
  display: flex;
  flex-direction: column;
}

.oil-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.oil-unit {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.oil-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.oil-price {
  display: flex;
  align-items: baseline;
}

.oil-price-symbol {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-right: 4rpx;
}

.oil-price-num {
  font-size: 52rpx;
  font-weight: bold;
  color: #1b2a4a;
  font-family: Menlo, Consolas, monospace;
  animation: price-pop 0.6s ease both;
}

@keyframes price-pop {
  0% { opacity: 0; transform: scale(0.6); }
  60% { transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1); }
}

.oil-change {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.oil-arrow {
  margin-right: 6rpx;
  font-weight: bold;
}

.change-up {
  color: #f5222d;
  animation: bounce-up 1s ease infinite;
}

.change-down {
  color: #52c41a;
  animation: bounce-down 1s ease infinite;
}

.change-flat {
  color: #999;
}

@keyframes bounce-up {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}

@keyframes bounce-down {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4rpx); }
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2c4a6e;
  margin: 0 8rpx;
  animation: dot-pulse 0.6s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes dot-pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}
