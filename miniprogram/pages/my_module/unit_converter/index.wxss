.container {
  padding: 20rpx;
}

.cat-scroll {
  white-space: nowrap;
}

.cat-list {
  display: inline-flex;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #f2f3f5;
  border-radius: 40rpx;
}

.cat-active {
  color: #fff;
  background-color: #ff5f15;
}

.input-panel {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.value-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
}

.unit-picker {
  font-size: 30rpx;
  color: #333;
  padding: 8rpx 20rpx;
  background-color: #f2f3f5;
  border-radius: 12rpx;
}

.arrow {
  color: #999;
}

.result-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.result-item:last-child {
  border-bottom: none;
}

.result-value {
  font-size: 32rpx;
  color: #333;
}

.result-unit {
  font-size: 28rpx;
  color: #999;
}
