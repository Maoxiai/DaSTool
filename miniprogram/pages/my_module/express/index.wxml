<view class="card">
  <view class="card-title">快递单号</view>
  <view class="field-row">
    <input class="field-input" value="{{no}}" data-key="no" bindinput="onField" placeholder="请输入快递单号" />
  </view>
</view>

<view class="result-card" wx:if="{{result}}">
  <view class="result-title">识别结果</view>
  <view class="result-row">
    <text class="result-label">快递公司</text>
    <text class="result-value">{{result.company}}</text>
  </view>
  <view class="result-row">
    <text class="result-label">客服电话</text>
    <text class="result-value">{{result.hotline}}</text>
  </view>
</view>

<view class="card">
  <view class="card-title">支持识别</view>
  <view class="tag-list">
    <text class="tag">顺丰</text>
    <text class="tag">中通</text>
    <text class="tag">圆通</text>
    <text class="tag">申通</text>
    <text class="tag">韵达</text>
    <text class="tag">京东</text>
    <text class="tag">邮政EMS</text>
    <text class="tag">极兔</text>
    <text class="tag">德邦</text>
    <text class="tag">百世</text>
  </view>
</view>

<view class="foot-tip">根据单号特征匹配，结果仅供参考</view>