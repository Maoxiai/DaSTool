<view class="container">
  <scroll-view class="cat-scroll" scroll-x="true">
    <view class="cat-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="cat-item {{currentTab === item.key ? 'cat-active' : ''}}"
        data-key="{{item.key}}"
        bind:tap="onTabTap">{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 鞋码换算 -->
  <view wx:if="{{currentTab === 'shoe'}}">
    <view class="panel">
      <text class="panel-title">脚长（厘米）</text>
      <input class="value-input" type="digit" value="{{footLength}}" bind:input="onFootLengthInput" />
    </view>

    <view class="result-list">
      <view wx:for="{{shoeResults}}" wx:key="name" class="result-item">
        <text class="result-name">{{item.name}}</text>
        <text class="result-value">{{item.value}}</text>
      </view>
    </view>

    <view class="tip">鞋码为参考值，不同品牌略有差异，建议以试穿为准。</view>
  </view>

  <!-- 服装尺码 -->
  <view wx:if="{{currentTab === 'clothes'}}">
    <view class="table">
      <view class="table-head">
        <text class="th">尺码</text>
        <text class="th">身高(cm)</text>
        <text class="th">胸围(cm)</text>
        <text class="th">腰围(cm)</text>
      </view>
      <view wx:for="{{clothesSizes}}" wx:key="size" class="table-row">
        <text class="td">{{item.size}}</text>
        <text class="td">{{item.height}}</text>
        <text class="td">{{item.chest}}</text>
        <text class="td">{{item.waist}}</text>
      </view>
    </view>

    <view class="tip">以上为通用参考尺寸，各品牌版型不同，请以商品详情为准。</view>
  </view>
</view>
