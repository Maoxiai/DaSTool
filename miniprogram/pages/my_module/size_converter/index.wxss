.container {
  padding: 20rpx;
}

.cat-scroll {
  white-space: nowrap;
}

.cat-list {
  display: inline-flex;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #f2f3f5;
  border-radius: 40rpx;
}

.cat-active {
  color: #fff;
  background-color: #ff5f15;
}

.panel {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.panel-title {
  font-size: 26rpx;
  color: #999;
}

.value-input {
  margin-top: 12rpx;
  height: 80rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.result-list {
  margin-top: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.result-item:last-child {
  border-bottom: none;
}

.result-name {
  font-size: 30rpx;
  color: #333;
}

.result-value {
  font-size: 32rpx;
  color: #ff5f15;
  font-weight: bold;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 0 20rpx;
}

/* 服装尺码表 */
.table {
  margin-top: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.table-head,
.table-row {
  display: flex;
}

.table-head {
  background-color: #fff7f2;
}

.th,
.td {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
}

.th {
  color: #ff5f15;
  font-weight: bold;
}

.td {
  color: #333;
}

.table-row {
  border-top: 1rpx solid #f2f3f5;
}
