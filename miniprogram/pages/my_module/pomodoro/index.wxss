.container {
  padding: 20rpx;
}

.phase-tag {
  margin-top: 20rpx;
  text-align: center;
}

.phase-text {
  font-size: 28rpx;
  color: #ff5f15;
  font-weight: bold;
  padding: 8rpx 32rpx;
  background-color: #fff7f2;
  border-radius: 32rpx;
}

.time-box {
  margin-top: 40rpx;
  text-align: center;
}

.time-text {
  font-size: 140rpx;
  font-weight: bold;
  color: #333;
  font-family: 'Courier New', monospace;
}

.progress-bar {
  margin: 40rpx auto 0;
  width: 100%;
  height: 16rpx;
  background-color: #f2f3f5;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background-color: #ff5f15;
  border-radius: 8rpx;
  transition: width 0.3s linear;
}

.controls {
  margin-top: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-main {
  width: 240rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  background-color: #ff5f15;
  border-radius: 48rpx;
}

.btn-reset {
  margin-left: 32rpx;
  width: 160rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  background-color: #f2f3f5;
  border-radius: 48rpx;
}

.settings {
  margin-top: 60rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #333;
}

.setting-value {
  font-size: 30rpx;
  color: #ff5f15;
  font-weight: bold;
}
