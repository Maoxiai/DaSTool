<view class="page">
  <!-- 顶部文案 -->
  <view class="intro">
    <text class="intro-title">你的一生，900 个月</text>
    <text class="intro-desc">每个格子代表一个月，看看你已经走过了多少</text>
  </view>

  <!-- 出生日期选择 -->
  <picker bindchange="bindDateChange" fields="month" mode="date" value="{{l4}}">
    <view class="picker-box">
      <text class="picker-label">出生日期</text>
      <text class="picker-value">{{l3}}</text>
    </view>
  </picker>

  <!-- 统计卡片 -->
  <view class="stats">
    <view class="stat">
      <text class="stat-num stat-passed">{{monthPassed}}</text>
      <text class="stat-label">已过（月）</text>
    </view>
    <view class="stat">
      <text class="stat-num stat-left">{{monthLeft}}</text>
      <text class="stat-label">剩余（月）</text>
    </view>
    <view class="stat">
      <text class="stat-num stat-pct">{{percent}}%</text>
      <text class="stat-label">人生进度</text>
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress">
    <view class="progress-bar" style="width: {{percent}}%;"></view>
  </view>

  <!-- 格子 -->
  <canvas disableScroll canvasId="canvas-grid" class="canvas" style="width: {{l1}}px; height: {{l1}}px;"></canvas>

  <!-- 寄语 -->
  <view class="foot">珍惜当下，认真生活 🌱</view>
</view>
