<view class="card" wx:for="{{rules}}" wx:key="name">
  <view class="card-icon">{{item.icon}}</view>
  <view class="card-body">
    <view class="card-name">{{item.name}}</view>
    <view class="card-desc">{{item.desc}}</view>
    <view class="demo">
      <view wx:for="{{item.shapes}}" wx:for-item="s" wx:key="index" class="shape shape-{{s.t}}" style="{{s.s}}"></view>
    </view>
  </view>
</view>

<view class="foot-tip">构图无定法，多尝试找到最合适的表达</view>
