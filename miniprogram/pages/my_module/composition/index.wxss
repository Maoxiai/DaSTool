.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: flex-start;
}

.card-icon {
  font-size: 56rpx;
  line-height: 1;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 25rpx;
  color: #777;
  line-height: 1.6;
}

/* 构图示意图 */
.demo {
  position: relative;
  width: 100%;
  height: 240rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  overflow: hidden;
}

.shape {
  position: absolute;
  box-sizing: border-box;
}

.shape-line {
  background: #cfd6de;
}

.shape-dot {
  background: #ff5f15;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.shape-block {
  background: #c8d6e5;
}

.shape-frame {
  border: 4rpx dashed #ff9d6b;
  background: rgba(255, 157, 107, 0.08);
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
