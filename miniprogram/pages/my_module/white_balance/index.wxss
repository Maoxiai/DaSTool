.color-preview {
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.color-k {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.color-desc {
  font-size: 26rpx;
  color: #fff;
  margin-top: 12rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.slider-scale {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
}

.preset {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
}

.preset-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  border: 1rpx solid #eee;
}

.preset-name {
  font-size: 24rpx;
  color: #333;
  margin-right: 10rpx;
}

.preset-k {
  font-size: 22rpx;
  color: #999;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}
