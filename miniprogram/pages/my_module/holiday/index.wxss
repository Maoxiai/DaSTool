.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.field-label {
  font-size: 28rpx;
  color: #333;
}

.picker-value {
  font-size: 26rpx;
  color: #4A90E2;
}

.holiday {
  display: flex;
  flex-direction: column;
}

.holiday-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.holiday-date {
  font-size: 26rpx;
  color: #4A90E2;
  margin-top: 8rpx;
}

.holiday-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.holiday-days {
  font-size: 22rpx;
  color: #fff;
  background: #ff5f15;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 14rpx;
}

.holiday-note {
  font-size: 22rpx;
  color: #999;
}

.foot-tip {
  text-align: center;
  color: #b8bdc9;
  font-size: 22rpx;
  padding: 10rpx 0 50rpx;
}