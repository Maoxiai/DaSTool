<view class="page {{darkMode ? 'dark' : ''}}">
  <!-- 分段 tab -->
  <view class="seg">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="seg-item {{currentTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bind:tap="onTabTap"
    >
      <text class="seg-icon">{{item.icon}}</text>
      <text class="seg-text">{{item.name}}</text>
    </view>
  </view>

  <!-- 日期差 -->
  <view class="panel" wx:if="{{currentTab === 'diff'}}">
    <view class="fields">
      <view class="field">
        <text class="field-label">起始日期</text>
        <picker mode="date" value="{{diffDate1}}" end="{{endDate}}" bind:change="onDiff1Change">
          <view class="field-value">{{diffDate1}} <text class="field-extra">{{diffWd1}}</text></view>
        </picker>
      </view>
      <view class="field-sep"></view>
      <view class="field">
        <text class="field-label">结束日期</text>
        <picker mode="date" value="{{diffDate2}}" end="{{endDate}}" bind:change="onDiff2Change">
          <view class="field-value">{{diffDate2}} <text class="field-extra">{{diffWd2}}</text></view>
        </picker>
      </view>
    </view>

    <view class="result">
      <view class="big">
        <text class="big-num">{{diffDays}}</text>
        <text class="big-unit">天</text>
      </view>
      <text class="sub">约 {{diffWeeks}} 周 · {{diffMonths}} 个月</text>
    </view>
  </view>

  <!-- 年龄计算 -->
  <view class="panel" wx:if="{{currentTab === 'age'}}">
    <view class="fields">
      <view class="field">
        <text class="field-label">出生日期</text>
        <picker mode="date" value="{{birth}}" end="{{endDate}}" bind:change="onBirthChange">
          <view class="field-value">{{birth}}</view>
        </picker>
      </view>
    </view>

    <view class="result">
      <view class="big">
        <text class="big-num">{{age}}</text>
        <text class="big-unit">岁</text>
      </view>
      <text class="sub">距离下次生日还有 {{daysToNext}} 天</text>
    </view>
  </view>

  <!-- 倒计时 -->
  <view class="panel" wx:if="{{currentTab === 'countdown'}}">
    <view class="fields">
      <view class="field">
        <text class="field-label">目标日期</text>
        <picker mode="date" value="{{target}}" end="{{endDate}}" bind:change="onTargetChange">
          <view class="field-value">{{target}}</view>
        </picker>
      </view>
    </view>

    <view class="result">
      <view class="cd-grid">
        <view class="cd-cell">
          <view class="cd-num">{{cdDays}}</view>
          <view class="cd-unit">天</view>
        </view>
        <view class="cd-cell">
          <view class="cd-num">{{cdHours}}</view>
          <view class="cd-unit">时</view>
        </view>
        <view class="cd-cell">
          <view class="cd-num">{{cdMinutes}}</view>
          <view class="cd-unit">分</view>
        </view>
        <view class="cd-cell">
          <view class="cd-num">{{cdSeconds}}</view>
          <view class="cd-unit">秒</view>
        </view>
      </view>
      <text class="sub">{{cdOver ? '目标日期已过去' : '距离目标日期'}}</text>
    </view>
  </view>
</view>
