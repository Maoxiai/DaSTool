<view class="container">
  <scroll-view class="cat-scroll" scroll-x="true">
    <view class="cat-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="cat-item {{currentTab === item.key ? 'cat-active' : ''}}"
        data-key="{{item.key}}"
        bind:tap="onTabTap">{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 日期差 -->
  <view wx:if="{{currentTab === 'diff'}}">
    <view class="panel">
      <text class="panel-title">起始日期</text>
      <picker mode="date" value="{{diffDate1}}" end="{{endDate}}" bind:change="onDiff1Change">
        <view class="date-picker">{{diffDate1}} {{diffWd1}} <text class="arrow">▾</text></view>
      </picker>
    </view>

    <view class="panel">
      <text class="panel-title">结束日期</text>
      <picker mode="date" value="{{diffDate2}}" end="{{endDate}}" bind:change="onDiff2Change">
        <view class="date-picker">{{diffDate2}} {{diffWd2}} <text class="arrow">▾</text></view>
      </picker>
    </view>

    <view class="result-panel">
      <view>
        <text class="result-big">{{diffDays}}</text>
        <text class="result-unit">天</text>
      </view>
      <view class="result-row">
        <view class="result-cell">
          <text class="result-cell-value">{{diffWeeks}}</text>
          <text class="result-cell-label">周</text>
        </view>
        <view class="result-cell">
          <text class="result-cell-value">{{diffMonths}}</text>
          <text class="result-cell-label">月（约）</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 年龄计算 -->
  <view wx:if="{{currentTab === 'age'}}">
    <view class="panel">
      <text class="panel-title">出生日期</text>
      <picker mode="date" value="{{birth}}" end="{{endDate}}" bind:change="onBirthChange">
        <view class="date-picker">{{birth}} <text class="arrow">▾</text></view>
      </picker>
    </view>

    <view class="result-panel">
      <view>
        <text class="result-big">{{age}}</text>
        <text class="result-unit">岁</text>
      </view>
      <view class="result-sub">距离下次生日还有 {{daysToNext}} 天</view>
    </view>
  </view>

  <!-- 倒计时 -->
  <view wx:if="{{currentTab === 'countdown'}}">
    <view class="panel">
      <text class="panel-title">目标日期</text>
      <picker mode="date" value="{{target}}" end="{{endDate}}" bind:change="onTargetChange">
        <view class="date-picker">{{target}} <text class="arrow">▾</text></view>
      </picker>
    </view>

    <view class="result-panel">
      <view>
        <text class="result-big">{{countdownDays}}</text>
        <text class="result-unit">天</text>
      </view>
      <view class="result-sub">{{countdownDays >= 0 ? '距离目标日期' : '目标日期已过去'}}</view>
    </view>
  </view>
</view>
