.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f6f6f6;
  box-sizing: border-box;
}

/* 关系链 */
.chain-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  min-height: 120rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  animation: fade-up 0.4s ease both;
}

.chain-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.chain-text {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-top: 12rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* 结果 */
.result-card {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #ff7a3d, #ff5f15);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 95, 21, 0.25);
  animation: fade-up 0.4s 0.06s ease both;
}

.result-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  line-height: 1.4;
}

/* 脑图入口 */
.map-entry {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  animation: fade-up 0.4s 0.09s ease both;
  transition: background 0.15s ease;
}

.map-entry-hover {
  background: #f5f6fa;
}

.map-entry-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.map-entry-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.map-entry-arrow {
  color: #ccc;
  font-size: 40rpx;
}

/* 性别 */
.gender {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  animation: fade-up 0.4s 0.12s ease both;
}

.gender-label {
  font-size: 28rpx;
  color: #333;
}

.gender-switch {
  display: flex;
  align-items: center;
}

.gender-txt {
  font-size: 28rpx;
  color: #999;
  transition: color 0.2s ease;
}

.gender-txt.on {
  color: #ff5f15;
  font-weight: 600;
}

.gender-s {
  margin: 0 12rpx;
  transform: scale(0.85);
}

/* 键盘 */
.keyboard {
  margin-top: 24rpx;
  background: #e9ecef;
  border-radius: 20rpx;
  padding: 16rpx;
  animation: fade-up 0.4s 0.18s ease both;
}

.row {
  display: flex;
  margin-bottom: 16rpx;
}

.row:last-child {
  margin-bottom: 0;
}

.key {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #fff;
  border-radius: 14rpx;
  margin-right: 16rpx;
  font-size: 34rpx;
  color: #333;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease, background 0.15s ease;
}

.key:last-child {
  margin-right: 0;
}

.key-hover {
  transform: scale(0.94);
  background: #f2f3f5;
}

.key-func {
  font-size: 28rpx;
  color: #666;
}

.key-danger {
  color: #ff5f15;
}

.key-equal {
  flex: 2;
  background: linear-gradient(135deg, #ff7a3d, #ff5f15);
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

.key-equal.key-hover {
  background: #e85510;
}

@keyframes fade-up {
  0% { transform: translateY(16rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
