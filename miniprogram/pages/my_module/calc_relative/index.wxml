<view class="page">
  <!-- 关系链 -->
  <view class="chain-card">
    <text class="chain-label">关系链</text>
    <text class="chain-text">{{screenData}}</text>
  </view>

  <!-- 结果 -->
  <view class="result-card" animation="{{resultAnim}}">
    <text class="result-text">{{result || '点击下方按钮，看看怎么称呼'}}</text>
  </view>

  <!-- 脑图入口 -->
  <view class="map-entry" hover-class="map-entry-hover" bindtap="goMap">
    <text class="map-entry-icon">🧭</text>
    <text class="map-entry-text">查看亲属关系脑图</text>
    <text class="map-entry-arrow">›</text>
  </view>

  <!-- 性别 -->
  <view class="gender">
    <text class="gender-label">我的性别</text>
    <view class="gender-switch">
      <text class="gender-txt {{sex === 1 ? 'on' : ''}}">男</text>
      <switch class="gender-s" bindchange="switchChange" checked="{{sex === 0}}" color="#ff5f15" />
      <text class="gender-txt {{sex === 0 ? 'on' : ''}}">女</text>
    </view>
  </view>

  <!-- 键盘 -->
  <view class="keyboard">
    <view class="row">
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id1}}">夫</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id2}}">妻</view>
      <view class="key key-func" hover-class="key-hover" bindtap="clickButton" id="{{id3}}">删除</view>
      <view class="key key-func key-danger" hover-class="key-hover" bindtap="clickButton" id="{{id4}}">清空</view>
    </view>
    <view class="row">
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id5}}">父</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id6}}">母</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id7}}">兄</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id8}}">弟</view>
    </view>
    <view class="row">
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id9}}">姐</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id10}}">妹</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id11}}">子</view>
      <view class="key" hover-class="key-hover" bindtap="clickButton" id="{{id12}}">女</view>
    </view>
    <view class="row">
      <view class="key key-func" hover-class="key-hover" bindtap="clickButton" id="{{id15}}">赞赏</view>
      <view class="key key-func" hover-class="key-hover" bindtap="clickButton" id="{{id13}}">互查</view>
      <view class="key key-equal" hover-class="key-hover" bindtap="clickButton" id="{{id14}}">=</view>
    </view>
  </view>
</view>
