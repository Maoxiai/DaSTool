.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.legend {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.legend-tip {
  font-size: 26rpx;
  color: #999;
}

.legend-types {
  display: flex;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  font-size: 24rpx;
  color: #666;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-direct { background: #ff5f15; }
.dot-collateral { background: #4a90e2; }
.dot-affinal { background: #9b59b6; }

/* 滚动容器 */
.map-scroll {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  height: 760rpx;
  flex-shrink: 0;
}

.map-inner {
  position: relative;
}

/* 连线 */
.mline {
  position: absolute;
  background: #c9cdd4;
}

/* 节点（绝对定位，中心对齐坐标） */
.mnode {
  position: absolute;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  animation: node-fade 0.3s ease both;
  box-sizing: border-box;
}

.mnode-hover {
  opacity: 0.75;
}

.mnode-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.mnode-label {
  font-size: 20rpx;
  color: #333;
  margin-top: 4rpx;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 关系类型配色 */
.type-direct {
  background: #fff7f0;
  border-color: #ffb38a;
}

.type-collateral {
  background: #eef4fc;
  border-color: #a9c9ec;
}

.type-affinal {
  background: #f6effa;
  border-color: #d0b3e0;
}

/* 「我」根节点 */
.mnode-root {
  background: linear-gradient(135deg, #ff7a3d, #ff5f15);
  border-color: #ff5f15;
  box-shadow: 0 6rpx 16rpx rgba(255, 95, 21, 0.35);
}

.mnode-root .mnode-label {
  color: #fff;
  font-weight: 600;
}

/* 展开/收起角标 */
.mnode-toggle {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 50%;
  background: #ff5f15;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

@keyframes node-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 信息卡片 */
.info-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.info-head {
  display: flex;
  align-items: center;
}

.info-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff5f15;
}

.info-relation {
  font-size: 22rpx;
  color: #fff;
  background: #ff5f15;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-left: 16rpx;
}

.info-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 14rpx;
}

.info-empty .info-title {
  color: #333;
}