.container {
  height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 按时段问候语 */
.greeting {
  flex-shrink: 0;
  width: 100%;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  background: #fff;
}

.greeting-left {
  display: flex;
  align-items: center;
}

.greeting-emoji {
  font-size: 60rpx;
  margin-right: 20rpx;
  animation: greet-bounce 0.6s ease;
}

.greeting-text {
  display: flex;
  flex-direction: column;
}

.greeting-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.greeting-date {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

@keyframes greet-bounce {
  0% { transform: scale(0.4); opacity: 0; }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); opacity: 1; }
}

/* 分类 tab */
.tabs {
  flex-shrink: 0;
  width: 100%;
  background: #fff;
  white-space: nowrap;
  z-index: 100;
}

.tabs-inner {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.tab {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 44rpx;
  background: #f2f3f5;
  transition: transform 0.2s ease, background 0.25s ease;
}

.tab:last-child {
  margin-right: 0;
}

.tab-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
  transition: transform 0.25s ease;
}

.tab-name {
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  background: #FF5F15;
  box-shadow: 0 6rpx 18rpx rgba(255, 95, 21, 0.35);
  animation: tab-pop 0.35s ease;
}

.tab.active .tab-icon {
  transform: scale(1.2);
}

.tab.active .tab-name {
  color: #fff;
  font-weight: 600;
}

@keyframes tab-pop {
  0% { transform: scale(1); }
  45% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

/* 工具列表内容区 */
.content {
  flex: 1;
  height: 0;
  width: 100%;
}

/* 热门卡片 */
.card-list {
  padding: 20rpx;
}

.card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  animation: card-in 0.45s ease both;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-hover {
  transform: scale(0.97);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.06);
}

@keyframes card-in {
  0% { transform: translateY(24rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.card-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-weight: 600;
  font-size: 26rpx;
  color: #fff;
}

.rank-medal {
  background: transparent;
  font-size: 44rpx;
  line-height: 1;
  animation: medal-float 2.4s ease-in-out infinite;
}

@keyframes medal-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.rank-n {
  background: #f2f3f5;
  color: #999;
}

.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fff7f2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.card-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-arrow {
  color: #ccc;
  font-size: 40rpx;
  margin-left: 16rpx;
  line-height: 1;
}

.page-body {
  height: 100vh;
  width: 100vw;
  flex: 1;
  overflow-y: scroll;
}
.footer{
  width: 100vw;
}

.swiper-item, .swiper, .banner_image{
  width: 100vw;
  height: 42.5vw;
}

.imgs {
  margin-top: -20rpx;
  height: 10vw;
  width: 10vw;
  margin-bottom: 5rpx;
}

.emoji-icon {
  font-size: 60rpx;
  line-height: 1.2;
  text-align: center;
  display: block;
}

.items-list-wrap {
  display: flex;
  flex-flow: row wrap;
  margin-top: 5rpx;
  width: 100%;
}

.item-list-wrap {
  display: flex;
  flex-direction: column;
  padding: 12rpx 0rpx;
  width: 25%;
  color: #333;
  align-items: center;
  animation: card-in 0.45s ease both;
  transition: transform 0.15s ease;
}

.item-hover {
  transform: scale(0.9);
}

.item_left {
  display: flex;
  justify-content: space-between;
  z-index: 888
}

.item_level {
  font-size: 18rpx;
  min-width: 30rpx;
  justify-content: center;
  background-color: #3d9140;
  border-radius: 8rpx;
  padding: 0rpx 5rpx;
  text-align: center;
  height: 22rpx;
  line-height: 22rpx;
  margin-left: 20rpx;
  margin-right: -50rpx;
  color: #fff;
}

.item_name{
  font-size: 10pt;
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

.widgets__info {
  align-items: center;
  background: #dfdfdf;
  display: flex;
  flex-direction: row;
  padding: 40rpx;
}

.widgets__info_show .widgets__info-img {
  transform: rotate(-180deg);
}

.widgets__info-name {
  flex: 1;
}

.widgets__info-img {
  height: 32rpx;
  transform: rotate(0deg);
  transition: transform .4s;
  transition: transform .4s,-webkit-transform .4s;
  width: 32rpx;
}

.top_info {
  width: 100vw;
  font-size: 40rpx;
  text-align: center;
  color: #FF5F15;
  display: flex;
  text-align: left;
  justify-content: center;
  padding: 10rpx 10rpx;
  background-color: #eeeeee;
}

/* 深色模式 */
.dark {
  background-color: #1f1f1f;
}

.dark .tabs {
  background-color: #1f1f1f;
}

.dark .greeting {
  background-color: #1f1f1f;
}

.dark .greeting-title {
  color: #e5e5e5;
}

.dark .greeting-date {
  color: #888;
}

.dark .tab {
  background-color: #2a2a2a;
}

.dark .tab-name {
  color: #999;
}

.dark .tab.active {
  background-color: #FF5F15;
  box-shadow: none;
}

.dark .tab.active .tab-name {
  color: #fff;
}

.dark .card {
  background-color: #2a2a2a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.dark .card-icon {
  background-color: #333;
}

.dark .rank-n {
  background-color: #333;
  color: #888;
}

.dark .card-name {
  color: #e5e5e5;
}

.dark .card-desc {
  color: #888;
}

.dark .card-arrow {
  color: #666;
}

.dark .item-list-wrap {
  color: #e5e5e5;
}

.dark .item_name {
  color: #e5e5e5;
}
