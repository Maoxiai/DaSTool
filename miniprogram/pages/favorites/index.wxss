.container {
  width: 100%;
  padding: 24rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  line-height: 1;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-top: 30rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.empty-btn {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: #ff5f15;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

/* 分类 Tab */
.tabs {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.tab {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 44rpx;
  background: #fff;
  transition: transform 0.2s ease, background 0.25s ease;
}

.tab:last-child {
  margin-right: 0;
}

.tab-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  transition: transform 0.25s ease;
}

.tab-name {
  font-size: 26rpx;
  color: #666;
}

.tab-count {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
  background: rgba(0, 0, 0, 0.06);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}

.tab.active {
  background: #FF5F15;
  box-shadow: 0 6rpx 18rpx rgba(255, 95, 21, 0.35);
  animation: tab-pop 0.35s ease;
}

.tab.active .tab-icon {
  transform: scale(1.2);
}

.tab.active .tab-name {
  color: #fff;
  font-weight: 600;
}

.tab.active .tab-count {
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
}

@keyframes tab-pop {
  0% { transform: scale(1); }
  45% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

/* 宫格（每行 4 列，float 布局，固定永不收缩） */
.grid {
  width: 100%;
  overflow: hidden;
}

.grid-item {
  float: left;
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx;
  position: relative;
  animation: card-in 0.45s ease both;
}

.grid-hover .cell {
  transform: scale(0.96);
}

.cell {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 6rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.grid-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: #fff7f2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-img {
  width: 56rpx;
  height: 56rpx;
}

.grid-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.grid-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-top: 14rpx;
  line-height: 1.3;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-fav {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  z-index: 2;
}

@keyframes card-in {
  0% { transform: translateY(24rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* 深色模式 */
.dark {
  background-color: #1f1f1f;
}

.dark .tab {
  background: #2a2a2a;
}

.dark .tab-name {
  color: #999;
}

.dark .tab.active {
  background: #FF5F15;
}

.dark .tab.active .tab-name {
  color: #fff;
}

.dark .cell {
  background: #2a2a2a;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.dark .grid-icon {
  background: #333;
}

.dark .grid-name,
.dark .empty-title {
  color: #e5e5e5;
}

.dark .empty-desc {
  color: #888;
}
